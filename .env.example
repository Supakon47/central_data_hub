# Use SQLite for a local demo. Docker Compose supplies PostgreSQL instead.
DATABASE_URL=sqlite:///./data/data_hub.db
APP_ENV=development
APP_NAME=Central Data Hub
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=100

# Keep this false until Google service-account credentials and approved source IDs exist.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to inline JSON. This must be a path inside the running container.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Administrator edit page. Generate values with: python -m app.generate_admin_credentials
# Keep these only in .env, never commit them.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
